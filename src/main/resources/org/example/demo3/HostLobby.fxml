<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="40.0" styleClass="game-screen-root"
      xmlns="http://javafx.com/javafx/21" fx:controller="org.example.demo3.view.HostLobbyController">
    <children>
        <Label styleClass="lan-title-label" text="Host Lobby"/>
        <VBox alignment="CENTER" spacing="15.0">
            <children>
                <Label fx:id="ipLabel" styleClass="lan-ip-address-label" text="Determining IP..."/>
                <Label fx:id="statusLabel" styleClass="lan-info-label" text="Waiting for an opponent to connect..."/>
            </children>
        </VBox>
        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackAction" styleClass="lan-menu-button"
                text="Cancel"/>
    </children>
    <padding>
        <Insets bottom="50.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</VBox>