<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="30.0" styleClass="game-screen-root"
      xmlns="http://javafx.com/javafx/21" fx:controller="org.example.demo3.view.JoinLobbyController">
    <children>
        <Label styleClass="lan-title-label" text="Join Lobby"/>
        <VBox alignment="CENTER" spacing="20.0">
            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label styleClass="lan-info-label" text="Host IP:"/>
                        <TextField fx:id="ipTextField" promptText="Enter IP Address" styleClass="lan-text-field"/>
                    </children>
                </HBox>
                <Label fx:id="statusLabel" styleClass="lan-info-label" text=" "/>
            </children>
        </VBox>
        <VBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="connectButton" mnemonicParsing="false" onAction="#handleConnectAction"
                        styleClass="lan-menu-button" text="Connect"/>
                <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackAction"
                        styleClass="lan-menu-button" text="Back"/>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="50.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</VBox>