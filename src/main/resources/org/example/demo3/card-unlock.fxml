<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="org.example.demo3.view.CardUnlockController"
          prefHeight="800.0" prefWidth="1200.0" alignment="CENTER" style="-fx-background-color: #1e1e1e;"
          hgap="10" vgap="20">

    <rowConstraints>
        <RowConstraints percentHeight="15"/>
        <RowConstraints percentHeight="70"/>
        <RowConstraints percentHeight="15"/>
    </rowConstraints>
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>

    <Button fx:id="spinButton" text="Spin!" onAction="#generateCard" GridPane.columnIndex="0" GridPane.rowIndex="0"
            GridPane.halignment="CENTER"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10 20;"/>

    <!-- Das Karussell-Fenster -->
    <StackPane fx:id="carouselPane" alignment="CENTER_LEFT"
               GridPane.columnIndex="0" GridPane.rowIndex="1"
               maxWidth="1000" maxHeight="320.0">

        <!-- HBox für die Bilder -->
        <HBox fx:id="rarityContainer" alignment="CENTER_LEFT" spacing="30.0"/>

        <!-- Zeiger in der Mitte -->
        <Rectangle width="5" height="340.0" fill="#FFD700"
                   stroke="black" strokeWidth="1" mouseTransparent="true"
                   StackPane.alignment="CENTER"/>
    </StackPane>

</GridPane>