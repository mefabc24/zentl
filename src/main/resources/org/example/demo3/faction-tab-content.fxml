<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<?import javafx.scene.layout.BorderPane?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo3.view.FactionTabController">
    <columnConstraints>
        <ColumnConstraints percentWidth="100"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints prefHeight="60" minHeight="60"/>
        <RowConstraints prefHeight="320" minHeight="320"/>
        <RowConstraints vgrow="ALWAYS"/>
    </rowConstraints>

    <!-- Top Container -->
    <GridPane GridPane.rowIndex="0" GridPane.columnIndex="0">
        <columnConstraints>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="40"/>
            <ColumnConstraints percentWidth="30"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints percentHeight="100"/>
        </rowConstraints>
        <HBox alignment="CENTER_LEFT" GridPane.columnIndex="0">
            <Label text="SORT BY">
                <HBox.margin>
                    <Insets right="10"/>
                </HBox.margin>
            </Label>
            <Button fx:id="tabRaritySortButton" text="RARITY" onAction="#handleTabSortByRarity"/>
            <Button fx:id="tabPowerSortButton" text="POWER" onAction="#handleTabSortByPower"/>
            <Button fx:id="tabRowTypeSortButton" text="ROWTYPE" onAction="#handleTabSortByRowType"/>
            <Button fx:id="tabCardTypeSortButton" text="CARDTYPE" onAction="#handleTabSortByCardType"/>
        </HBox>
        <StackPane GridPane.columnIndex="1">
            <TextField promptText="SEARCH..." fx:id="tabSearchTextField"/>
        </StackPane>
        <HBox alignment="CENTER_RIGHT" GridPane.columnIndex="2">
            <Button fx:id="tabToggleVisibilityButton" text="SHOW LOCKED" onAction="#handleTabToggleVisibility"/>
            <Button fx:id="tabUnselectAllButton" text="UNSELECT ALL" onAction="#handleTabUnselectAll"/>
            <Button fx:id="tabRandomizeButton" text="RANDOMIZE" onAction="#handleTabRandomize" />
        </HBox>
    </GridPane>
    <!-- Top Container END -->

    <!-- Bereich für ausgewählte Karten -->
    <BorderPane GridPane.rowIndex="1" GridPane.columnIndex="0">
        <top>
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 5 5 0;">
                <Label fx:id="tabSelectedCountLabel" text="0/0" style="-fx-font-size: 16px; -fx-text-fill: #E0E0E0;"/>
            </HBox>
        </top>
        <center>
            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                <content>
                    <FlowPane fx:id="tabSelectedCardsFP" hgap="5" vgap="5">
                        <padding>
                            <Insets top="5" right="5" bottom="5" left="5"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>

    <!-- Bereich für alle Karten -->
    <ScrollPane fx:id="tabCardScrollPane" GridPane.rowIndex="2" GridPane.columnIndex="0" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
        <content>
            <FlowPane fx:id="tabAllCardsFP">
                <!-- Inhalt wird dynamisch gefüllt -->
            </FlowPane>
        </content>
    </ScrollPane>
</GridPane>