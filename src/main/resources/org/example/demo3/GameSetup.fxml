<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo3.view.GameSetupController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 36px; -fx-text-fill: #E0E0E0;" text="Game Setup">
        <VBox.margin>
            <Insets bottom="40.0" />
        </VBox.margin>
    </Label>

    <GridPane hgap="20.0" maxWidth="800.0" vgap="20.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <!-- Player 1 -->
        <Label text="Player 1" style="-fx-font-size: 22px;" GridPane.halignment="RIGHT" />
        <ComboBox fx:id="p1FactionComboBox" prefHeight="40.0" prefWidth="400.0" promptText="Select Faction" GridPane.columnIndex="1" />
        <Label fx:id="p1DeckStatusLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Deck Status" GridPane.columnIndex="2">
            <GridPane.margin>
                <Insets left="10.0" />
            </GridPane.margin>
        </Label>

        <!-- Player 2 -->
        <Label text="Player 2" style="-fx-font-size: 22px;" GridPane.halignment="RIGHT" GridPane.rowIndex="1" />
        <ComboBox fx:id="p2FactionComboBox" prefHeight="40.0" prefWidth="400.0" promptText="Select Faction" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label fx:id="p2DeckStatusLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Deck Status" GridPane.columnIndex="2" GridPane.rowIndex="1">
            <GridPane.margin>
                <Insets left="10.0" />
            </GridPane.margin>
        </Label>
    </GridPane>

    <HBox alignment="CENTER" spacing="30.0">
        <VBox.margin>
            <Insets top="50.0" />
        </VBox.margin>
        <Button fx:id="startGameButton" mnemonicParsing="false" onAction="#handleStartGameAction" prefHeight="60.0" prefWidth="250.0" styleClass="primary-action-button" text="Start Game" />
        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackAction" prefHeight="50.0" prefWidth="200.0" text="Back to Menu" />
    </HBox>
</VBox>