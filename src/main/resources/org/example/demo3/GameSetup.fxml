<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" styleClass="main-menu-root" xmlns="http://javafx.com/javafx/17"
           fx:controller="org.example.demo3.view.GameSetupController">

    <VBox alignment="CENTER" spacing="20.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <ImageView fitWidth="1600" preserveRatio="true">
            <image>
                <Image url="@assets/UI_Components/deck_selection/header.png"/>
            </image>
            <VBox.margin>
                <Insets bottom="50.0"/>
            </VBox.margin>
        </ImageView>

        <GridPane hgap="20.0" maxWidth="900.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="400.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES"/>
            </rowConstraints>

            <Label fx:id="player1Label" text="Player 1" styleClass="deck-label" GridPane.halignment="RIGHT"/>
            <ComboBox fx:id="p1FactionComboBox" prefHeight="50.0" prefWidth="400.0" promptText="Select Faction"
                      styleClass="deck-combo-box" GridPane.columnIndex="1"/>
            <Label fx:id="p1DeckStatusLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Deck Status"
                   GridPane.columnIndex="2">
                <GridPane.margin>
                    <Insets left="10.0"/>
                </GridPane.margin>
            </Label>

            <Label fx:id="player2Label" text="Player 2" styleClass="deck-label" GridPane.halignment="RIGHT"
                   GridPane.rowIndex="1"/>
            <ComboBox fx:id="p2FactionComboBox" prefHeight="50.0" prefWidth="400.0" promptText="Select Faction"
                      styleClass="deck-combo-box" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label fx:id="p2DeckStatusLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Deck Status"
                   GridPane.columnIndex="2" GridPane.rowIndex="1">
                <GridPane.margin>
                    <Insets left="10.0"/>
                </GridPane.margin>
            </Label>
        </GridPane>

        <HBox alignment="CENTER" spacing="30.0">
            <VBox.margin>
                <Insets top="60.0"/>
            </VBox.margin>

            <Button fx:id="startGameButton" onAction="#handleStartGameAction">
                <styleClass>
                    <String fx:value="main-menu-button"/>
                    <String fx:value="deck-start-button"/>
                </styleClass>
            </Button>

            <Button fx:id="backButton" onAction="#handleBackAction">
                <styleClass>
                    <String fx:value="main-menu-button"/>
                    <String fx:value="deck-back-button"/>
                </styleClass>
            </Button>
        </HBox>
    </VBox>
</StackPane>